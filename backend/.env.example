# Copy this file to ".env" in the backend folder and fill in real values.
# NEVER commit the real .env file.

# Database (matches docker-compose defaults — change the password for any real deployment)
DATABASE_URL=postgresql://internsight:CHANGE_ME@localhost:5432/internsight

# Auth — generate a long random string, e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

# AI features (resume chat, cover letter, summary, suggestions) — falls back to rule-based if unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub stats integration — optional, raises rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# Portfolio live hosting (Netlify personal access token) — optional
NETLIFY_TOKEN=

# Coding round (Judge0 via RapidAPI) — optional, needed for "Run Code"
RAPIDAPI_KEY=
